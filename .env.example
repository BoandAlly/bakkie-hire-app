# Copy this file to `.env` and fill in the two values from your Supabase
# project: Dashboard -> Settings -> API.
#
# `.env` is git-ignored. The anon key is designed to be shipped in a client app,
# but while the test policies in supabase/schema.sql are wide open, anyone with
# this key can read and write everything — so don't post it publicly.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OPTIONAL — real street addresses with house numbers.
# Without this, the address search falls back to the free OpenStreetMap map,
# which has no South African house numbers (it can only find the road). With a
# TomTom key, typing "90 Round the Green" finds the actual house and pins it.
# Get a free key (no credit card, ~2,500 searches/day) at developer.tomtom.com,
# then paste it here. The app runs fine without it.
VITE_TOMTOM_API_KEY=
