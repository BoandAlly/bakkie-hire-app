# Copy this file to `.env` and fill in the two values from your Supabase
# project: Dashboard -> Settings -> API.
#
# `.env` is git-ignored. The anon key is designed to be shipped in a client app,
# but while the test policies in supabase/schema.sql are wide open, anyone with
# this key can read and write everything — so don't post it publicly.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
